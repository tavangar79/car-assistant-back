NODE_ENV=development
PORT=3000
DATABASE_URL="mongodb://localhost:27017/car_assistant?replicaSet=rs0&directConnection=true"
# Number of reverse proxies in front of the API (0 = none). Needed so the per-IP limit sees client IPs.
TRUST_PROXY_HOPS=0

# Auth (JWT). The server refuses to boot with this placeholder; use e.g. `openssl rand -hex 32`.
# Also keys the HMAC of stored OTP codes.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_EXPIRES_IN=30d

# SMS: console (logs the code; not allowed in production) | kavenegar
SMS_PROVIDER=console
# Required only when SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# OTP
OTP_LENGTH=5
# Optional, dev/QA only: every OTP is this code (must have OTP_LENGTH digits, e.g. 12345).
# Leave empty for random codes. The server refuses to boot with it in production.
OTP_FIXED_CODE=
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
# Wrong guesses allowed per sent code
OTP_MAX_ATTEMPTS=5
# Codes one phone may request per rolling window (window must be >= the resend cooldown)
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_SECONDS=3600

# Per-IP limit shared by POST /api/auth/otp/request and /otp/verify (in memory, per process)
AUTH_IP_RATE_LIMIT_MAX=30
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=900
