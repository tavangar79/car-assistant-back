NODE_ENV=development
PORT=3000
DATABASE_URL="mongodb://localhost:27017/car_assistant?replicaSet=rs0&directConnection=true"
# Number of reverse proxies in front of the API (0 = none). Needed so the per-IP limit sees client IPs.
TRUST_PROXY_HOPS=0
# Browser origins allowed by CORS (comma-separated, e.g. https://app.example.com,http://localhost:5173).
# http://localhost:5173 is the admin panel (admin/) dev server.
# Outside production any http://localhost:<port> / http://127.0.0.1:<port> is also allowed (Flutter web dev).
CORS_ORIGINS=

# Auth (JWT). The server refuses to boot with this placeholder; use e.g. `openssl rand -hex 32`.
# Also keys the HMAC of stored OTP codes.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_EXPIRES_IN=30d

# Admin panel tokens (`aud: "admin"`). Required; must differ from JWT_SECRET, and the server refuses to
# boot with this placeholder. Rotating it signs the admin out (there is no other revocation).
ADMIN_JWT_SECRET=change-me-to-another-random-string-of-32-plus-chars
ADMIN_JWT_EXPIRES_IN=10d

# Encrypts vehicle document files at rest (AES-256-GCM). Base64 of exactly 32 bytes; the server refuses
# to boot without it. Generate with `openssl rand -base64 32`. Losing or changing it makes stored files unreadable.
DOCUMENT_ENCRYPTION_KEY=

# Uploaded files (avatars, photos, invoices, attachments, encrypted documents) live here, never in MongoDB.
# Relative to the working directory; defaults to ./uploads. Back it up together with the database.
UPLOAD_DIR=./uploads

# SMS: console (logs the code; not allowed in production) | kavenegar
SMS_PROVIDER=console
# Required only when SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# OTP
OTP_LENGTH=5
# DEV/TEST ONLY: every OTP is this code (must have OTP_LENGTH digits).
# Leave empty in production (random codes); the server refuses to boot with it there.
OTP_FIXED_CODE=12345
# Rate limits (resend cooldown, per-phone cap, per-IP limit). Defaults to true.
# Set to false for local dev only; never in production.
OTP_RATE_LIMIT_ENABLED=false
# Code lifetime; kept equal to the resend cooldown so a code stays valid until a resend is possible
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=300
# Wrong guesses allowed per sent code
OTP_MAX_ATTEMPTS=5
# Codes one phone may request per rolling window (window must be >= the resend cooldown)
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_SECONDS=3600

# Per-IP limit shared by POST /api/auth/otp/request and /otp/verify (in memory, per process)
AUTH_IP_RATE_LIMIT_MAX=30
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=900
