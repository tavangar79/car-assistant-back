// Prisma ORM 6.19 is used because Prisma 7 has no MongoDB connector
// and Prisma 8 (Mongo-native) is still a release candidate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// A car in one user's garage. Make/model/trim are ids from the static vehicle catalog (backend code).
// Plate uniqueness per user is checked by the service: older documents lack these fields,
// so a unique index could not be built over them.
model Vehicle {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  userId     String        @db.ObjectId
  nickname   String
  plate      Plate
  vin        String?
  makeId     String
  modelId    String
  trimId     String?
  yearJalali Int
  mileageKm  Int
  color      VehicleColor?
  isDefault  Boolean       @default(false)
  /// Set when an ownership transfer is accepted; null = owned since createdAt.
  /// Service visits, fuel logs and expenses created before it are locked for the new owner.
  ownedSince DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@map("vehicles")
}

// A seller's request to hand a vehicle to the owner of `toPhone`. The vehicle moves only when the buyer accepts.
model VehicleTransfer {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId   String    @db.ObjectId
  fromUserId  String    @db.ObjectId
  /// Normalized with normalizeIranianPhone (same as login).
  toPhone     String
  /// pending | accepted | rejected | cancelled
  status      String
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([vehicleId])
  @@index([toPhone, status])
  @@index([fromUserId, status])
  @@map("vehicle_transfers")
}

/// Iranian plate, Latin digits: 72 ب 345 - 68.
type Plate {
  twoDigits    String
  letter       String
  threeDigits  String
  provinceCode String
}

enum VehicleColor {
  white
  black
  silver
  blue
  red
  beige
}

// Vehicle photo, one per vehicle; an upload replaces it. Bytes stay out of `vehicles` so vehicle reads stay small.
model VehiclePhoto {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId   String   @unique @db.ObjectId
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt

  @@map("vehicle_photos")
}

// One odometer reading of a vehicle. Recording one also sets Vehicle.mileageKm (never lower).
// Deleted with the vehicle by VehicleService.remove.
model OdometerReading {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId  String   @db.ObjectId
  mileageKm  Int
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([vehicleId])
  @@map("odometer_readings")
}

// One workshop visit of a vehicle. Line items reference the static service-items catalog (backend code).
// `totalCost` is the sum of lineItems.cost, computed by ServiceVisitService. Deleted with the vehicle.
model ServiceVisit {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId   String            @db.ObjectId
  serviceDate DateTime
  odometerKm  Int
  workshop    String
  notes       String?
  lineItems   ServiceLineItem[]
  totalCost   Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([vehicleId, serviceDate])
  @@map("service_visits")
}

type ServiceLineItem {
  itemId        String
  brand         String?
  /// Part and labour together (one field on the screen), in toman.
  cost          Int
  notes         String?
  /// Sticker reminder: km after `odometerKm` (a delta).
  nextDueKm     Int?
  /// Sticker reminder: months after `serviceDate`.
  nextDueMonths Int?
}

// Invoice photo, one per visit; an upload replaces it. Bytes stay out of `service_visits` so list reads stay small.
// `sizeBytes` is stored so the visit JSON can report it without loading the bytes.
model ServiceInvoice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String   @unique @db.ObjectId
  fileName    String
  contentType String
  sizeBytes   Int
  data        Bytes
  updatedAt   DateTime @updatedAt

  @@map("service_invoices")
}

// One refuelling of a vehicle. `economy` (L/100 km) is computed on read by FuelLogService, never stored.
// A higher odometer also raises Vehicle.mileageKm. Deleted with the vehicle.
model FuelLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId     String   @db.ObjectId
  fueledAt      DateTime
  odometerKm    Int
  /// regular | super | cng | lpg
  fuelType      String
  /// Litres (m³ for cng), at most 2 decimals.
  volume        Float
  /// Toman.
  totalCost     Int
  isFullFill    Boolean
  station       String?
  /// personal_fuel_card | station_fuel_card | bank_card | cash
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vehicleId, fueledAt])
  @@map("fuel_logs")
}

// One non-service cost of a vehicle (insurance, fine, toll, ...). Never touches Vehicle.mileageKm. Deleted with the vehicle.
model Expense {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId       String    @db.ObjectId
  /// third_party_insurance | body_insurance | fine | toll | inspection | other
  category        String
  /// Toman.
  amount          Int
  title           String?
  referenceNumber String?
  paidAt          DateTime
  expiresAt       DateTime?
  /// The "ارسال اعلان یادآور" checkbox; used by Phase 5 notifications.
  expiryReminder  Boolean   @default(true)
  /// online | pos
  paymentMethod   String?
  issuer          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vehicleId, paidAt])
  @@map("expenses")
}

// Attached receipt or policy, one per expense; an upload replaces it. Bytes stay out of `expenses` so list reads stay small.
model ExpenseAttachment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId   String   @unique @db.ObjectId
  fileName    String
  /// application/pdf | image/jpeg | image/png
  contentType String
  sizeBytes   Int
  data        Bytes
  updatedAt   DateTime @updatedAt

  @@map("expense_attachments")
}

// A vehicle document (insurance, inspection, card, ...). `expiresAt` null = permanent. Deleted with the vehicle.
model VehicleDocument {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId      String    @db.ObjectId
  /// third_party_insurance | body_insurance | inspection | vehicle_card | green_sheet | power_of_attorney
  type           String
  title          String?
  issuer         String?
  /// Policy / serial / VIN.
  number         String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  expiryReminder Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vehicleId])
  @@map("vehicle_documents")
}

// Up to 4 files per document (checked by DocumentService). Bytes are encrypted at rest.
model VehicleDocumentFile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId  String   @db.ObjectId
  fileName    String
  /// application/pdf | image/jpeg | image/png
  contentType String
  /// Plaintext size.
  sizeBytes   Int
  /// AES-256-GCM: iv(12) | authTag(16) | ciphertext.
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@map("vehicle_document_files")
}

// An in-app notification, generated lazily on read by NotificationService.sync. `key` makes generation idempotent.
// Rows older than 90 days are deleted on sync.
model Notification {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  vehicleId     String    @db.ObjectId
  key           String
  /// interval_due_soon | interval_overdue | expense_expiry | document_expiry
  kind          String
  /// intervalId, expenseId or documentId.
  refId         String
  /// Snapshot title (Persian).
  subject       String
  dueKm         Int?
  remainingKm   Int?
  mileageKm     Int?
  /// Expiry kinds: the expiry; interval kinds: the due date.
  expiresAt     DateTime?
  /// Expiry kinds: 30 | 15 | 7.
  thresholdDays Int?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, createdAt])
  @@map("notifications")
}

// A vehicle's override of one service interval. Only overrides are stored; a missing row means factory default.
model ServiceInterval {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId  String   @db.ObjectId
  intervalId String
  km         Int
  months     Int
  updatedAt  DateTime @updatedAt

  @@unique([vehicleId, intervalId])
  @@map("service_intervals")
}

// One service item definition in one scope. All scope ids null = global; the most specific matching
// row (trim > model > make > global) fully replaces the definition for a vehicle.
// `itemId` is stored on service visits, so it is never renamed.
model ServiceItemDef {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId     String
  makeId     String?
  modelId    String?
  trimId     String?
  categoryId String
  title      String
  subtitle   String
  /// Material Symbols icon name.
  icon       String
  sortOrder  Int
  disabled   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([itemId, makeId, modelId, trimId])
  @@map("service_item_defs")
}

// One service interval definition in one scope; resolved like ServiceItemDef.
// `intervalId` is stored on ServiceInterval overrides, so it is never renamed.
model IntervalDef {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  intervalId    String
  makeId        String?
  modelId       String?
  trimId        String?
  title         String
  description   String
  icon          String
  coversItemIds String[]
  /// Default km, 500..200000.
  km            Int
  /// Default months, 1..120.
  months        Int
  sortOrder     Int
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([intervalId, makeId, modelId, trimId])
  @@map("interval_defs")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  phone     String    @unique
  firstName String?
  lastName  String?
  /// UTC midnight of the Gregorian birth date.
  birthDate DateTime?
  /// user | admin. Granted with `npm run admin:grant -- <phone>`.
  role      String    @default("user")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

// At most one pending code per phone; a new request replaces it.
// codeHash = HMAC-SHA256(server secret, phone + code).
// Prisma 6 can't declare a Mongo TTL index, so expired codes are deleted on each OTP request.
model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("otp_codes")
}

// One row per code sent; drives the resend cooldown and the per-phone cap.
// Rows older than OTP_REQUEST_WINDOW_SECONDS are deleted on each OTP request.
model OtpRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String
  createdAt DateTime

  @@index([phone, createdAt])
  @@index([createdAt])
  @@map("otp_requests")
}

// Profile photo, one per user; an upload replaces it. Bytes stay out of `users` so user reads stay small.
model UserAvatar {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt

  @@map("user_avatars")
}
